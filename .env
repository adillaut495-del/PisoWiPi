# PisoPilot hardware settings. hardware.py reads this file on startup (real environment
# variables always win), so `cp .env.example .env` is enough on the Pi or in development.
# The full wiring and router procedure lives in router/README.md.

# Set real only on the Raspberry Pi controller after wiring is verified.
PISO_HARDWARE_MODE=real


# Werkzeug reloader. Keep 1 while developing; set 0 on the Pi, because the reloader runs app.py
# twice and only the serving process may own the coin pin.
PISO_DEBUG=0

# MikroTik RouterOS REST API. Prefer https:// and www-ssl.
PISO_ROUTER_URL=https://192.168.88.1/rest
PISO_ROUTER_USER=piso-controller
PISO_ROUTER_PASSWORD=9g3zu9g9LQet8HdU1viZ
PISO_ROUTER_VERIFY_SSL=0
# Hotspot user profile a paying device is put on, and the session QoS tiers that
# swap it: "download/upload MBps" -> profile name. Both profiles are created by
# router/hap-ax-lite-piso.rsc.
PISO_ROUTER_PROFILE=piso-package
PISO_ROUTER_RATE_PROFILES={"2/1":"piso-package","5/2":"piso-premium"}
# How often the controller re-checks the clock and cuts off expired clients.
PISO_ROUTER_SWEEP_SECONDS=15

# Allan Universal Coinslot 1239A Promax pulse output.
# Keep the 12 V COIN signal away from GPIO17. With a compatible relay module, dry
# COM/NO contacts switch GPIO17 to Pi ground (router/README.md section 2). Measure
# the pulse count per denomination with tools/coin_pulse_probe.py before trusting the map.
PISO_COIN_GPIO=17
PISO_COIN_PULL_UP=1
# 1 = the relay's NO contact pulls GPIO17 low on a pulse. Use 0 only for a
# separately verified active-high 3.3 V interface.
PISO_COIN_ACTIVE_LOW=1
# Suppress brief relay contact bounce per edge.
PISO_COIN_EDGE_DEBOUNCE_MS=8
PISO_COIN_DEBOUNCE_MS=100
# JSON map: pulse count to peso denomination. Default assumes one pulse per peso.
PISO_COIN_PULSES={"1":1,"5":2,"10":3,"20":4}

# Uplink probe behind the online/offline indicator on both consoles.
# TCP targets first, then PISO_INTERNET_DNS resolution as a fallback.
PISO_INTERNET_PROBES=1.1.1.1:53,8.8.8.8:53
PISO_INTERNET_DNS=one.one.one.one
PISO_INTERNET_TIMEOUT_SECONDS=1.5
PISO_INTERNET_CACHE_SECONDS=5
